# VayuX Systems — Production Environment Configuration Template
DEBUG=False
SECRET_KEY=replace-with-ultra-secure-django-secret-key-at-least-50-chars
ALLOWED_HOSTS=vayux.systems,api.vayux.systems,localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=https://vayux.systems,https://www.vayux.systems,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://vayux.systems,https://*.vercel.app

# ==============================================================================
# Aiven PostgreSQL Database Configuration (Production)
# ==============================================================================
# Paste your Service URI directly from the Aiven Console:
DATABASE_URL=postgres://avnadmin:YOUR_AIVEN_PASSWORD@pg-YOUR-SERVICE-NAME.aivencloud.com:12345/defaultdb?sslmode=require

# Sensitive Field Encryption (Fernet 32-byte Base64 key)
FIELD_ENCRYPTION_KEY=replace-with-fernet-encryption-key==

# Email Configuration (SendGrid / AWS SES / Brevo / SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
NOTIFICATION_EMAIL_SENDER=sentinel@vayux.systems
DFIR_ALERT_EMAIL_RECIPIENT=dfir@vayux.systems
