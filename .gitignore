# ==============================================================================
# VayuX Systems — Master .gitignore (Monorepo: Django Backend + Next.js Frontend)
# ==============================================================================

# --- Environment Variables & Secrets (CRITICAL SECURITY) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
*.pem
*.key
*.crt

# --- Python & Django ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.venv*/

# Django Staticfiles & Uploaded Media
staticfiles/
**/staticfiles/
media/resumes/
**/media/resumes/*
!media/resumes/.gitkeep

# Django Database (Local SQLite)
*.sqlite3
db.sqlite3
db.sqlite3-journal

# --- Node.js & Next.js Frontend ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js Build Outputs
.next/
**/.next/
out/
**/out/

# Vercel Deployment Metadata
.vercel/
**/.vercel/

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# --- Testing & Coverage ---
.coverage
.coverage.*
htmlcov/
.pytest_cache/
coverage/
**/coverage/

# --- IDE & Editor Specific ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Antigravity / AI Agent Artifacts & Scratchpads ---
.gemini/
